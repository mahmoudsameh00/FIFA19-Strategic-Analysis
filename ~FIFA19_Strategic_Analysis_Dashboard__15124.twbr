      <aliases enabled='yes' />
      <column caption='Backup Name' datatype='string' name='[Backup_Name]' role='dimension' type='nominal' />
      <column caption='Player Name (Staggered Full)' datatype='string' name='[Calculation_0449450850816000]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Case 1: Wide gap? Keep normal.&#13;&#10;IF [Gap] &gt; 5 THEN&#13;&#10;    [Calculation_1250444961853440]&#13;&#10;&#13;&#10;// Case 2: Starter (Top). &#13;&#10;// We add lines AFTER. Note the &quot; &quot; (space) added to force the line to have height.&#13;&#10;ELSEIF [Pivot Field Names] = &quot;Starter Rating&quot; THEN&#13;&#10;    [Calculation_1250444961853440] + &#13;&#10;    CHAR(10) + &quot; &quot; + &#13;&#10;    CHAR(10) + &quot; &quot;&#13;&#10;&#13;&#10;// Case 3: Backup (Bottom). &#13;&#10;// We add lines BEFORE.&#13;&#10;ELSE&#13;&#10;    &quot; &quot; + CHAR(10) + &#13;&#10;    &quot; &quot; + CHAR(10) + &#13;&#10;    [Calculation_1250444961853440]&#13;&#10;END' />
      </column>
      <column caption='Rating (Separated)' datatype='real' name='[Calculation_0449450853502977]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// If the ratings are identical (Gap = 0), push them apart slightly.&#13;&#10;IF [Gap] = 0 AND [Pivot Field Names] = &quot;Starter Rating&quot; THEN&#13;&#10;    [Pivot Field Values] - 0.1  // Push Starter left&#13;&#10;ELSEIF [Gap] = 0 AND [Pivot Field Names] = &quot;Backup Rating&quot; THEN&#13;&#10;    [Pivot Field Values] + 0.1  // Push Backup right&#13;&#10;ELSE&#13;&#10;    [Pivot Field Values]        // Otherwise, keep the real rating&#13;&#10;END' />
      </column>
      <column caption='Player Label' datatype='string' name='[Calculation_0875236551270403]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Pivot Field Names] = &apos;Starter_Rating&apos; THEN [Starter_Name]&#13;&#10;ELSE [Backup_Name]&#13;&#10;END' />
      </column>
      <column caption='Player Name (Dynamic)' datatype='string' name='[Calculation_1250444961853440]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Pivot Field Names] = &quot;Starter Rating&quot; THEN [Starter_Name]&#13;&#10;ELSEIF [Pivot Field Names] = &quot;Backup Rating&quot; THEN [Backup_Name]&#13;&#10;END' />
      </column>
      <column datatype='string' name='[Club]' role='dimension' type='nominal' />
      <column caption='Role' datatype='string' name='[Pivot Field Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;Backup Rating&quot;' value='Backup ' />
          <alias key='&quot;Starter Rating&quot;' value='Starter ' />
        </aliases>
      </column>
      <column caption='Rating' datatype='integer' name='[Pivot Field Values]' role='measure' type='quantitative' />
