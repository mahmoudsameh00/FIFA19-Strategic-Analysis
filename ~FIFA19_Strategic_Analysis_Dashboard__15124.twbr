      <column caption='Color: Urgency vs Age' datatype='integer' name='[Calculation_1049237086031875]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Urgency_Group]&#13;&#10;    WHEN &quot;1. Crisis (Expiring &lt; 12m)&quot; THEN -100 + [Age]&#13;&#10;    WHEN &quot;2. Urgent (2 Years Left)&quot;   THEN -50 + [Age]&#13;&#10;    WHEN &quot;3. Stable (3 Years Left)&quot;   THEN  50 + [Age]&#13;&#10;    WHEN &quot;4. Secure (Long Term)&quot;      THEN  100 + [Age]&#13;&#10;    ELSE 0&#13;&#10;END' />
      </column>
      <column caption='Color: Year Shade' datatype='real' name='[Calculation_1049237090361348]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Contract_Years_Remaining] * 100) + [Age]' />
      </column>
