      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans SemiDemi'>Succession Intelligence: Bridging the Positional Gap</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>Evaluating internal assets that mirror the starter’s stylistic profile while ensuring their market valuation remains aligned with a supporting role.</run>
            <run>Æ&#10;</run>
            <run fontcolor='#75a1c7' fontname='Benton Sans Book' fontsize='11'><![CDATA[<[federated.1wk5gnp0bx6ba1118vs150222klk].[none:Starter_Ref:nk]>]]></run>
            <run fontsize='11'>Æ </run>
            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='11'>vs. </run>
            <run fontcolor='#72b966' fontname='Benton Sans Book' fontsize='11'><![CDATA[<[federated.1wk5gnp0bx6ba1118vs150222klk].[none:Calculation_0701241442226182:nk]>]]></run>
            <run>Æ&#10;</run>
            <run fontsize='5'>-------------------------------------------------------------------------------</run>
            <run>Æ&#10;</run>
            <run fontsize='10'><![CDATA[RECOMMENDATION BACKUP: <[federated.1wk5gnp0bx6ba1118vs150222klk].[attr:Meta_BackupName:nk]>]]></run>
            <run>Æ&#10;</run>
            <run fontsize='10'><![CDATA[Club: <[federated.1wk5gnp0bx6ba1118vs150222klk].[attr:Meta_Club:nk]>   |  Position: <[federated.1wk5gnp0bx6ba1118vs150222klk].[none:Position:nk]>  |  Style Match: <[federated.1wk5gnp0bx6ba1118vs150222klk].[max:Meta_Similarity:qk]>%]]></run>
            <run>Æ&#10;</run>
            <run fontsize='10'><![CDATA[Market Value: €<[federated.1wk5gnp0bx6ba1118vs150222klk].[max:Meta_Value:qk]>   |   Salary Gap: -<[federated.1wk5gnp0bx6ba1118vs150222klk].[max:Meta_Discount:qk]>%]]></run>
            <run>Æ&#10;</run>
            <run fontsize='10'><![CDATA[Rating Gap: <[federated.1wk5gnp0bx6ba1118vs150222klk].[max:Meta_Gap:qk]> Overall]]></run>
          </formatted-text>
        </title>
